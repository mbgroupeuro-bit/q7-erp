@echo off
REM Lokales Git-Backup fuer Q7-ERP.
REM Kein Push und keine Kopie an andere Orte - Commits bleiben auf diesem Rechner.
REM Die Datei muss im Projektordner liegen: D:\Projekt2027\ERP System\

cd /d "%~dp0" || exit /b 1

if not exist ".git" (
    echo %date% %time% - Kein Git-Repo gefunden, initialisiere neu. >> git-backup-log.txt
    git init
    (
        echo node_modules/
        echo .env
        echo .env*
        echo envzuruck
        echo dist/
        echo *.log
        echo git-backup-log.txt
    ) > .gitignore
    git add -A
    git commit -m "Erster Commit - Repo initialisiert" >> git-backup-log.txt 2>&1
    exit /b 0
)

git add -A
git diff --cached --quiet
if errorlevel 1 (
    git commit -m "Automatisches Backup %date% %time%" >> git-backup-log.txt 2>&1
) else (
    echo %date% %time% - Keine Aenderungen - kein Commit noetig. >> git-backup-log.txt
)
