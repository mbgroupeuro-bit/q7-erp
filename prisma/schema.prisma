// Q7-ERP Kern-Datenmodell — Phase 1
// Multi-Tenancy: Option A (geteilte Tabellen), abgesichert über lizenznehmer_id
// + PostgreSQL Row-Level Security (RLS-Policies separat als SQL-Migration anzulegen)
// Primärschlüssel: UUID v7/ULID vorgesehen (Admin-Entscheidung) — Prisma unterstützt
// v7 nicht nativ über @default(uuid()); Generierung erfolgt aktuell anwendungsseitig
// (z.B. via "uuidv7"-Paket in der Service-Schicht) oder per DB-Default/Extension.
// Platzhalter unten: @default(uuid()) erzeugt Standard-v4 — vor Produktivbetrieb ersetzen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// LIZENZNEHMER (Wurzel-Tabelle, keine eigene lizenznehmer_id nötig)
// ---------------------------------------------------------------
model Lizenznehmer {
  id             String      @id @default(uuid())
  name           String
  rechtsform     String?
  adresseStrasse String?
  adressePlz     String?
  adresseOrt     String?
  adresseLand    String?
  steuernummer   String?
  ustId          String?
  lizenzstufe    Lizenzstufe @default(SMALL)
  status         Status      @default(AKTIV)
  erstelltAm     DateTime    @default(now())
  aktualisiertAm DateTime    @updatedAt

  partner          Partner[]
  artikel          Artikel[]
  konten           Konto[]
  benutzer         Benutzer[]
  zugriffshistorie Zugriffshistorie[]
  q7Verbindung     Q7Verbindung?
  sicherheitsEmail String?

  lagerorte       Lagerort[]
  lagerbestaende  Lagerbestand[]
  lagerbewegungen Lagerbewegung[]

  crmKontakte       CrmKontakt[]
  crmAktivitaeten   CrmAktivitaet[]
  crmWiedervorlagen CrmWiedervorlage[]
  crmAngebote       CrmAngebot[]

  mitarbeiter Mitarbeiter[]
  arbeitstage Arbeitstag[]
  vorschuesse Vorschuss[]

  // D02 (Block D E-Commerce/Fulfillment) — Modul-Aktivierung + Konfiguration
  lizenznehmerModule      LizenznehmerModul[]
  zahlungKonfigurationen  ZahlungKonfiguration[]
  logistikKonfigurationen LogistikKonfiguration[]
  shopKonfigurationen     ShopKonfiguration[]

  // NEU (D04, Block D E-Commerce/Fulfillment) — Bestellungen
  bestellungen Bestellung[]

  @@map("lizenznehmer")
}

enum Lizenzstufe {
  SMALL
  MEDIUM
  ENTERPRISE
}

enum Status {
  AKTIV
  INAKTIV
}

// ---------------------------------------------------------------
// BENUTZER (Login für Auth-Modul, JWT enthält lizenznehmerId)
// ---------------------------------------------------------------
model Benutzer {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  email        String @unique
  passwortHash String

  istSystemAdmin Boolean @default(false) // Aufgabe 26: Admin-Guard für LizenznehmerController

  status     Status   @default(AKTIV)
  erstelltAm DateTime @default(now())

  @@index([lizenznehmerId])
  @@map("benutzer")
}

// ---------------------------------------------------------------
// PARTNER (Kunden & Lieferanten des Lizenznehmer-Betriebs)
// ---------------------------------------------------------------
model Partner {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  typ              PartnerTyp
  name             String
  ansprechpartner  String?
  adresseStrasse   String?
  adressePlz       String?
  adresseOrt       String?
  adresseLand      String?
  email            String?
  telefon          String?
  steuernummer     String?
  ustId            String?
  zahlungszielTage Int?       @default(30)
  status           Status     @default(AKTIV)
  erstelltAm       DateTime   @default(now())

  crmKontakte CrmKontakt[]
  artikelLieferanten ArtikelLieferant[]

  @@index([lizenznehmerId])
  @@map("partner")
}

enum PartnerTyp {
  KUNDE
  LIEFERANT
  BEIDES
}

// ---------------------------------------------------------------
// ARTIKEL — Kern (Stufe 1) + Verweise auf Erweiterungsstufen
// ---------------------------------------------------------------
model Artikel {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  artikelnummer String
  name          String
  beschreibung  String?
  grundpreis    Decimal @db.Decimal(12, 2)
  einheit       String

  elternArtikelId String? // gesetzt bei Varianten (Stufe 2)
  elternArtikel   Artikel?  @relation("Varianten", fields: [elternArtikelId], references: [id])
  varianten       Artikel[] @relation("Varianten")

  istBundle         Boolean @default(false) // Stufe 3
  istKonfigurierbar Boolean @default(false) // Stufe 4

  status     ArtikelStatus @default(AKTIV)
  mindestbestand     Decimal? @db.Decimal(12, 3) // A148: Schwellenwert für Bestellvorschlag. NULL = kein Schwellenwert definiert, Artikel wird im Bestellvorschlag ignoriert.
  lagerrelevant      Boolean  @default(true)     // A148: false = Artikel wird nie im Bestellvorschlag berücksichtigt (z.B. Dienstleistungen)
  erstelltAm DateTime      @default(now())

  merkmale           ArtikelMerkmal[]
  bundleBestandteile BundlePosition[] @relation("BundleTeile")
  istTeilVonBundle   BundlePosition[] @relation("BestandteilVon")
  bausteinGruppen    BausteinGruppe[]

  lagerbestaende  Lagerbestand[]
  lagerbewegungen Lagerbewegung[]

  crmAngebotPositionen CrmAngebotPosition[]

  artikelLieferanten ArtikelLieferant[]

  // NEU (D04, Block D E-Commerce/Fulfillment)
  bestellPositionen BestellPosition[]

  @@index([lizenznehmerId])
  @@map("artikel")
}

enum ArtikelStatus {
  AKTIV
  INAKTIV
  AUSLAUFEND
}

// ---------------------------------------------------------------
// STUFE 2 — VARIANTEN: Merkmale je Variante
// ---------------------------------------------------------------
model ArtikelMerkmal {
  id             String  @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS (siehe 3.6)
  artikelId      String
  artikel        Artikel @relation(fields: [artikelId], references: [id])

  merkmalName String // z.B. "Farbe"
  merkmalWert String // z.B. "Rot"

  @@index([lizenznehmerId])
  @@map("artikel_merkmal")
}

// ---------------------------------------------------------------
// STUFE 3 — BUNDLE: Stückliste
// ---------------------------------------------------------------
model BundlePosition {
  id             String @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS

  bundleArtikelId String
  bundleArtikel   Artikel @relation("BundleTeile", fields: [bundleArtikelId], references: [id])

  bestandteilArtikelId String
  bestandteilArtikel   Artikel @relation("BestandteilVon", fields: [bestandteilArtikelId], references: [id])

  menge Decimal @db.Decimal(10, 2)

  @@index([lizenznehmerId])
  @@map("bundle_position")
}

// ---------------------------------------------------------------
// STUFE 4 — KONFIGURATION: Baustein-Gruppen, Optionen, Regeln
// ---------------------------------------------------------------
model BausteinGruppe {
  id             String  @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS
  artikelId      String
  artikel        Artikel @relation(fields: [artikelId], references: [id])

  gruppenName String // z.B. "Breite"
  pflichtfeld Boolean @default(true)

  optionen BausteinOption[]

  @@index([lizenznehmerId])
  @@map("baustein_gruppe")
}

model BausteinOption {
  id             String         @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS
  gruppeId       String
  gruppe         BausteinGruppe @relation(fields: [gruppeId], references: [id])

  optionsName    String
  preisaufschlag Decimal @default(0) @db.Decimal(12, 2)

  @@index([lizenznehmerId])
  @@map("baustein_option")
}

model Konfigurationsregel {
  id                     String @id @default(uuid())
  lizenznehmerId         String // redundant mitgeführt für RLS
  wennOptionId           String
  dannAusschlussOptionId String

  @@index([lizenznehmerId])
  @@map("konfigurationsregel")
}

// ---------------------------------------------------------------
// A148 — ARTIKEL-LIEFERANT: mehrere Bezugsquellen pro Artikel,
// mit Priorität (1 = Hauptlieferant) und freien Konditionen-Notizen.
// ---------------------------------------------------------------
model ArtikelLieferant {
  id                 String   @id @default(uuid())
  lizenznehmerId     String   // redundant mitgeführt für RLS (siehe 3.6)

  artikelId          String
  artikel            Artikel  @relation(fields: [artikelId], references: [id])

  lieferantId        String   // Partner mit typ = LIEFERANT oder BEIDES
  lieferant          Partner  @relation(fields: [lieferantId], references: [id])

  prioritaet         Int      // 1 = Hauptlieferant, 2 = zweite Bezugsquelle, usw.
  einkaufspreis      Decimal  @db.Decimal(12, 2)
  mindestbestellmenge Decimal? @db.Decimal(12, 3)
  bemerkung          String?  // Freitext: Gebinde, Zahlungsziel, Servicequalität etc.

  erstelltAm         DateTime @default(now())

  @@index([lizenznehmerId])
  @@index([artikelId])
  @@map("artikel_lieferant")
}

// ---------------------------------------------------------------
// KONTEN — Basis-Kontenrahmen (Stammdaten für spätere Buchhaltung)
// ---------------------------------------------------------------
model Konto {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  kontonummer String
  bezeichnung String
  kontotyp    Kontotyp
  status      Status   @default(AKTIV)

  @@index([lizenznehmerId])
  @@map("konten")
}

enum Kontotyp {
  AKTIV_KONTO
  PASSIV_KONTO
  ERTRAG
  AUFWAND
}

// ---------------------------------------------------------------
// ERP-TÜRSTEHER — Zugriffshistorie + Q7-Verbindung (Signaturprüfung)
// ---------------------------------------------------------------
model Zugriffshistorie {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  ipAdresse String
  quelle    String
  anfrageId String   @unique
  zeitpunkt DateTime @default(now())

  ergebnis TuersteherErgebnis
  grund    String?

  @@index([lizenznehmerId, zeitpunkt])
  @@index([lizenznehmerId, ipAdresse])
  @@map("zugriffshistorie")
}

enum TuersteherErgebnis {
  ERLAUBT
  BLOCKIERT
  VERDAECHTIG_ERLAUBT_MIT_BENACHRICHTIGUNG
}

model Q7Verbindung {
  id             String       @id @default(uuid())
  lizenznehmerId String       @unique
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  geteiltesGeheimnis String
  webhookUrl         String? // A74 — Ziel-URL für ausgehende Events an Q7.
  aktiv              Boolean  @default(true)
  erstelltAm         DateTime @default(now())
  letzteRotation     DateTime @default(now())

  @@map("q7_verbindung")
}

// ---------------------------------------------------------------
// LAGER — Etappe 3 (Phase 2): Lagerort, Bestand, Bewegungshistorie
// ---------------------------------------------------------------
model Lagerort {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  name        String // z.B. "Hauptlager"
  istStandard Boolean  @default(false) // genau ein Lagerort pro Lizenznehmer sollte true sein
  status      Status   @default(AKTIV)
  erstelltAm  DateTime @default(now())

  lagerbestaende  Lagerbestand[]
  lagerbewegungen Lagerbewegung[]

  // NEU (D04, Block D E-Commerce/Fulfillment)
  bestellungen Bestellung[]

  @@index([lizenznehmerId])
  @@map("lagerort")
}

model Lagerbestand {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  artikelId String
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  lagerortId String
  lagerort   Lagerort @relation(fields: [lagerortId], references: [id])

  menge          Decimal  @db.Decimal(12, 3)
  aktualisiertAm DateTime @updatedAt

  @@unique([artikelId, lagerortId])
  @@index([lizenznehmerId])
  @@map("lagerbestand")
}

model Lagerbewegung {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  artikelId String
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  lagerortId String
  lagerort   Lagerort @relation(fields: [lagerortId], references: [id])

  typ        LagerbewegungTyp
  menge      Decimal          @db.Decimal(12, 3) // immer positiv; Vorzeichen/Richtung ergibt sich ausschließlich aus "typ"
  referenz   String? // z.B. Beleg-Nr., Bundle-Verkauf-ID, künftig auch Bestellung-ID (D04)
  bemerkung  String?
  erstelltAm DateTime         @default(now())

  @@index([lizenznehmerId])
  @@index([artikelId, lagerortId])
  @@map("lagerbewegung")
}

enum LagerbewegungTyp {
  WARENEINGANG
  WARENAUSGANG
  KORREKTUR_AUFWAERTS
  KORREKTUR_ABWAERTS
  BUNDLE_ABBUCHUNG
}

// ---------------------------------------------------------------
// CRM — Block B: Kontakt/Lead + Aktivitäten/Wiedervorlagen/Angebote
// ---------------------------------------------------------------
model CrmKontakt {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  name    String
  email   String?
  telefon String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  pipelineStatus CrmPipelineStatus @default(NEU)
  quelle         String?

  status         Status   @default(AKTIV)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  aktivitaeten   CrmAktivitaet[]
  wiedervorlagen CrmWiedervorlage[]
  angebote       CrmAngebot[]

  @@index([lizenznehmerId])
  @@map("crm_kontakt")
}

enum CrmPipelineStatus {
  NEU
  KONTAKTIERT
  ANGEBOT
  GEWONNEN
  VERLOREN
}

model CrmAktivitaet {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  crmKontaktId String
  crmKontakt   CrmKontakt @relation(fields: [crmKontaktId], references: [id])

  text String

  erstelltAm DateTime @default(now())

  @@index([lizenznehmerId])
  @@index([crmKontaktId])
  @@map("crm_aktivitaet")
}

model CrmWiedervorlage {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  crmKontaktId String
  crmKontakt   CrmKontakt @relation(fields: [crmKontaktId], references: [id])

  text              String
  faelligkeitsDatum DateTime
  erledigt          Boolean  @default(false)

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@index([crmKontaktId])
  @@map("crm_wiedervorlage")
}

model CrmAngebot {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  crmKontaktId String
  crmKontakt   CrmKontakt @relation(fields: [crmKontaktId], references: [id])

  status     CrmAngebotStatus @default(ENTWURF)
  gueltigBis DateTime?

  positionen CrmAngebotPosition[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@index([crmKontaktId])
  @@map("crm_angebot")
}

enum CrmAngebotStatus {
  ENTWURF
  VERSENDET
  ANGENOMMEN
  ABGELEHNT
}

model CrmAngebotPosition {
  id             String @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS (siehe 3.6)

  crmAngebotId String
  crmAngebot   CrmAngebot @relation(fields: [crmAngebotId], references: [id])

  artikelId String
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  menge Decimal @db.Decimal(12, 3)

  einzelpreis Decimal @db.Decimal(12, 2)

  @@index([lizenznehmerId])
  @@index([crmAngebotId])
  @@map("crm_angebot_position")
}

// ---------------------------------------------------------------
// HR — Block C: Mitarbeiter-Stammdaten, Zeiterfassung, Vorschuss
// ---------------------------------------------------------------
model Mitarbeiter {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  name    String
  telefon String?

  verguetungsArt    VerguetungsArt
  verguetungsBetrag Decimal        @db.Decimal(12, 2)
  provisionBetrag   Decimal?       @db.Decimal(12, 2)

  status         Status   @default(AKTIV)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  arbeitstage Arbeitstag[]
  vorschuesse Vorschuss[]

  @@index([lizenznehmerId])
  @@map("mitarbeiter")
}

enum VerguetungsArt {
  TAGESLOHN
  MONATSGEHALT
}

model Arbeitstag {
  id             String       @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS (siehe 3.6)
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id])

  datum      DateTime @db.Date
  gearbeitet Boolean  @default(true) // A147: true = Häkchen, false = X (Fehltag)
  bemerkung  String?

  erstelltAm DateTime @default(now())

  @@unique([mitarbeiterId, datum])
  @@index([lizenznehmerId])
  @@index([mitarbeiterId])
  @@map("arbeitstag")
}

model Vorschuss {
  id             String       @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS (siehe 3.6)
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id])

  betrag    Decimal  @db.Decimal(12, 2)
  datum     DateTime @db.Date
  bemerkung String?

  erstelltAm DateTime @default(now())

  @@index([lizenznehmerId])
  @@index([mitarbeiterId])
  @@map("vorschuss")
}

// ---------------------------------------------------------------
// E-COMMERCE / FULFILLMENT — Block D, Aufgabe D02
// Grundlage: Q7ERP_Konzept_ModulKonfiguration_v1.md (Grill-Me D01,
// Verdict PROCEED, 17.09.2026). Siehe Kommentare dort für die
// Begründung jeder Entscheidung; hier nur Kurzfassung.
// ---------------------------------------------------------------
model LizenznehmerModul {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  modulTyp ModulTyp
  aktiv    Boolean  @default(false)

  aktiviertAm    DateTime?
  erstelltAm     DateTime  @default(now())
  aktualisiertAm DateTime  @updatedAt

  @@unique([lizenznehmerId, modulTyp])
  @@index([lizenznehmerId])
  @@map("lizenznehmer_modul")
}

enum ModulTyp {
  LOGISTIK
  ZAHLUNG
  SHOP
}

model ZahlungKonfiguration {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  adapterName  String // z.B. "cod" (MVP)
  zugangsdaten Json?

  aktiv          Boolean  @default(true) // Deaktivierung: nur false setzen, nicht löschen
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@map("zahlung_konfiguration")
}

model LogistikKonfiguration {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  adapterName   String  // z.B. "dhl"
  apiSchluessel String? // verschlüsselt (VerschluesselungService)
  zugangsdaten  Json?

  aktiv          Boolean  @default(true)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@map("logistik_konfiguration")
}

model ShopKonfiguration {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  adapterName   String  // z.B. "shopify", "woocommerce"
  shopUrl       String?
  apiSchluessel String? // verschlüsselt (VerschluesselungService)
  zugangsdaten  Json?

  aktiv          Boolean  @default(true)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@map("shop_konfiguration")
}

// ---------------------------------------------------------------
// E-COMMERCE / FULFILLMENT — Block D, Aufgabe D04
// Grundlage: Q7ERP_Konzept_Bestellung_v1.md (Grill-Me D03, Verdict
// PROCEED, 18.09.2026).
//
// Kunde: inline auf Bestellung (kein CrmKontakt-Bezug, D03 Entsch. 1)
// — bewusste Trennung von Vertriebs-Leads.
//
// Zahlung/Logistik: Snapshot statt Live-FK zu den D02-Konfigurations-
// tabellen (D03 Entsch. 2) — Bestellhistorie bleibt unveränderlich,
// auch wenn eine Konfiguration später geändert/deaktiviert wird.
//
// Status: festes Enum, bewusst KEINE konfigurierbare Pipeline wie im
// CRM-Modul (D03 Entsch. 3) — Fulfillment-Status ist mandanten-
// unabhängig universell, anders als eine Vertriebspipeline.
//
// Lager-Kopplung: kein Schema-Aspekt. BestellungService (D05) muss
// LagerService.warenausgangBuchen() sauber aufrufen, keine eigene
// Lager-Logik/direkter Tabellenzugriff (D03 Entsch. 4, hält 3.2 ein).
//
// mwstSatz: pro Position, nicht nur auf Bestellebene (D03 Entsch. 5)
// — vermeidet Probleme bei gemischt besteuerten Bestellungen.
// ---------------------------------------------------------------
model Bestellung {
  id             String       @id @default(uuid())
  lizenznehmerId String
  lizenznehmer   Lizenznehmer @relation(fields: [lizenznehmerId], references: [id])

  quelle           String  // z.B. "manuell", "shop", "facebook", "whatsapp"
  externeBestellId String? // gesetzt bei Shop-Import (D19/D20), sonst NULL bei manueller Erfassung

  status BestellStatus @default(NEU)

  // Kunde — bewusst inline, kein CrmKontakt-Bezug (D03 Entsch. 1)
  kundeName    String
  kundeTelefon String?
  kundeAdresse String?

  // Zahlung — Snapshot, keine Live-FK zu ZahlungKonfiguration (D03 Entsch. 2)
  zahlartAdapterName String // z.B. "cod"

  // Logistik — Snapshot, keine Live-FK zu LogistikKonfiguration (D03 Entsch. 2)
  carrierAdapterName String? // gesetzt sobald Versand ausgelöst wurde (D11)
  sendungsnummer     String? // von Carrier-API erhalten (D11)

  lagerortId String?
  lagerort   Lagerort? @relation(fields: [lagerortId], references: [id])

  // D05: bewusst beide Werte gespeichert statt einer Einstellung
  // (Netto vs. Brutto) — hält die Bestellhistorie eindeutig (D03,
  // Entscheidung 2: Snapshot-Prinzip), ohne dass künftig eine
  // Einstellungsänderung die Interpretation alter Bestellungen
  // in Frage stellt. Berechnet aus mwstSatz je BestellPosition.
  gesamtbetragNetto  Decimal @db.Decimal(12, 2)
  gesamtbetragBrutto Decimal @db.Decimal(12, 2)

  positionen BestellPosition[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([lizenznehmerId])
  @@index([lizenznehmerId, status])
  @@map("bestellung")
}

enum BestellStatus {
  NEU
  IN_BEARBEITUNG
  VERSANDT
  ABGESCHLOSSEN
  STORNIERT
}

model BestellPosition {
  id             String @id @default(uuid())
  lizenznehmerId String // redundant mitgeführt für RLS (siehe 3.6)

  bestellungId String
  bestellung   Bestellung @relation(fields: [bestellungId], references: [id])

  artikelId String
  artikel   Artikel @relation(fields: [artikelId], references: [id])

  menge       Decimal @db.Decimal(12, 3)
  einzelpreis Decimal @db.Decimal(12, 2)
  mwstSatz    Decimal @db.Decimal(5, 2) // D03 Entsch. 5 — pro Position, nicht nur auf Bestellebene

  @@index([lizenznehmerId])
  @@index([bestellungId])
  @@map("bestell_position")
}
